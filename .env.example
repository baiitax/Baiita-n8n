# Copy this file with `npm run setup` to generate strong local secrets.
# Do not commit .env or share its values.
N8N_ENCRYPTION_KEY=__GENERATE_WITH_NPM_RUN_SETUP__
POSTGRES_PASSWORD=__GENERATE_WITH_NPM_RUN_SETUP__

# Pin the n8n image so upgrades are deliberate and reviewable.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.43.0
POSTGRES_USER=n8n
POSTGRES_DB=n8n

# Local-only ports. Keep services bound to loopback unless protected by TLS.
DASHBOARD_PORT=4173
DASHBOARD_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_BIND_ADDRESS=127.0.0.1

# Public URL settings. For a TLS reverse proxy, set these to the public HTTPS URL.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Etc/UTC
